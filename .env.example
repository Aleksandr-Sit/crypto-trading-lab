# Скопируй в .env и заполни. Значения нигде не логируются — только «заполнено / пусто».
# Ключи площадок создавай БЕЗ права вывода средств: ключ с withdraw отклоняется при старте.
# Пояснения — ОТДЕЛЬНЫМИ строками над ключом, а не хвостом после значения. Так надо:
# хвостовой комментарий срезает только парсер лаборатории, а docker compose (env_file)
# отдаёт его в контейнер КАК ЗНАЧЕНИЕ — и система считает, что ключ заполнен.
# `cp .env.example .env` даёт рабочую конфигурацию без ключей (все площадки «только данные»).

# --- База и сервисы ---------------------------------------------------------
# Значение ниже — для запуска с хоста (CLI, alembic, `lab service ...`).
# В docker compose DATABASE_URL подставляется самим compose (host `db`) и это значение
# не используется; менять его для compose не нужно. Свой пароль — здесь и в POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5432/lab
# пароль пользователя lab для контейнера db (compose, по умолчанию lab)
POSTGRES_PASSWORD=
# потолок реального капитала первой фазы, USD (500–1000); пусто = из limits.yaml
REAL_CAPITAL_CAP=
# лимит на платные источники в месяц, USD (В3: 50)
BUDGET_MONTH_USD=
# каталог резервных копий базы (бэкап 03:00)
BACKUP_DIR=
# адрес:порт веб-экрана НА ХОСТЕ, например 127.0.0.1:8080 (8080 занят — ставь 127.0.0.1:8090)
WEB_BIND=
# логин HTTP Basic для веб-экрана
WEB_USER=
# пароль HTTP Basic для веб-экрана
WEB_PASSWORD=
# 1 — разрешить тесты с живыми API (по умолчанию пропускаются)
LAB_LIVE_TESTS=
# сети через запятую: solana,evm,ton (остальные — по флагу, G07)
CHAINS_ENABLED=

# --- Биржи (CEX) и DEX-перпы ------------------------------------------------
# ключ Bybit (только торговля, без вывода)
BYBIT_API_KEY=
# секрет Bybit
BYBIT_API_SECRET=
# ключ OKX
OKX_API_KEY=
# секрет OKX
OKX_API_SECRET=
# passphrase OKX
OKX_API_PASSPHRASE=
# ключ Binance
BINANCE_API_KEY=
# секрет Binance
BINANCE_API_SECRET=
# приватный ключ агент-кошелька Hyperliquid (не основной кошелёк)
HYPERLIQUID_PRIVATE_KEY=

# --- Robinhood и Polymarket -------------------------------------------------
# ключ Robinhood Crypto API
ROBINHOOD_API_KEY=
# приватный ключ подписи Robinhood
ROBINHOOD_PRIVATE_KEY=
# приватный ключ кошелька для Polymarket CLOB
POLYMARKET_PRIVATE_KEY=

# --- Горячие кошельки сетей (только тестовый капитал) -----------------------
# приватный ключ горячего кошелька Solana
SOLANA_HOT_WALLET_KEY=
# приватный ключ горячего кошелька Ethereum/Base/BNB
EVM_HOT_WALLET_KEY=
# мнемоника горячего кошелька TON
TON_HOT_WALLET_MNEMONIC=

# --- Источники данных -------------------------------------------------------
# Helius (Solana RPC и индексация)
HELIUS_API_KEY=
# Alchemy (EVM RPC)
ALCHEMY_API_KEY=
# Etherscan / Basescan / BscScan
ETHERSCAN_API_KEY=
# The Graph (сабграфы DEX). ЗАРЕЗЕРВИРОВАНО НА БУДУЩЕЕ: код и конфиги этот ключ не читают,
# регистрироваться и заполнять не нужно. Ключ там выдаётся только после подключения кошелька.
THEGRAPH_API_KEY=
# Jupiter (свопы и котировки Solana). ЗАРЕЗЕРВИРОВАНО: площадка используется, но её публичный
# API работает без ключа — код этот ключ не спрашивает.
JUPITER_API_KEY=
# Magic Eden (NFT)
MAGICEDEN_API_KEY=
# OpenSea (NFT)
OPENSEA_API_KEY=
# Tensor (NFT Solana) — при получении ключа
TENSOR_API_KEY=
# tonapi.io
TONAPI_KEY=
# Dune Analytics
DUNE_API_KEY=
# Cielo (смарт-мани фиды)
CIELO_API_KEY=
# Тарифы ниже проверены ВЫЗОВОМ 14.09.2026, а не по страницам цен: Coinglass
# оказался платным целиком, у Glassnode API нет даже на тарифе за $49 — оба убраны.
# Разбор и полный список бесплатных источников без ключа (Coin Metrics, Deribit,
# alternative.me, blockchain.info, BitMEX) — docs/research/free-data-audit-2026-09-14.md.
#
# CryptoQuant — бесплатный аккаунт cryptoquant.com. ВАЖНО: тариф отдаёт только
# последние 30 суток (глубже — 400 Out of allowed request range), резервы бирж закрыты.
# Годен исключительно для накопления вперёд: задание `cryptoquant`, 03:20 ежедневно.
CRYPTOQUANT_API_KEY=
# Coinalyze — ликвидации, открытый интерес и фандинг по биржам; бесплатный ключ
# на coinalyze.net, 40 запросов в минуту. Это замена платному Coinglass.
# Проверено вызовом: ~1500 точек на ряд, то есть ЧЕТЫРЕ ГОДА суточных ликвидаций
# (с 2022-08) — в отличие от CryptoQuant, эти ряды годятся для замеров на истории.
COINALYZE_API_KEY=
# Velo Data — деривативы пяти площадок плюс CME; бесплатный аккаунт velo.xyz.
VELO_API_KEY=
# CoinGecko — demo-ключ (бесплатный). Без него публичный API отвечает 401.
COINGECKO_API_KEY=
# Santiment — соц-объём, активность разработчиков и РЕЗЕРВЫ БИРЖ (exchange_balance).
# Ключ НЕобязателен: GraphQL отвечает анонимно, год истории с задержкой 30 суток;
# ключ поднимает только лимит запросов.
SANTIMENT_API_KEY=
# источник свечей акций: alphavantage | yfinance
STOCK_DATA_PROVIDER=
# ключ Alpha Vantage (если STOCK_DATA_PROVIDER=alphavantage)
ALPHAVANTAGE_API_KEY=

# --- Telegram ----------------------------------------------------------------
# токен бота Trader
TELEGRAM_BOT_TOKEN=
# числовой id администратора; команды только от него
TELEGRAM_ADMIN_ID=
# необязательно: api_id Telethon; есть путь без ключей — веб-превью t.me/s
TELEGRAM_API_ID=
# необязательно: api_hash Telethon (нужен только вместе с api_id)
TELEGRAM_API_HASH=
