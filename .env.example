# Скопируй в .env и заполни. Значения нигде не логируются — только «заполнено / пусто».
# Ключи площадок создавай БЕЗ права вывода средств: ключ с withdraw отклоняется при старте.
# Пояснения — ОТДЕЛЬНЫМИ строками над ключом, а не хвостом после значения. Так надо:
# хвостовой комментарий срезает только парсер лаборатории, а docker compose (env_file)
# отдаёт его в контейнер КАК ЗНАЧЕНИЕ — и система считает, что ключ заполнен.
# `cp .env.example .env` даёт рабочую конфигурацию без ключей (все площадки «только данные»).

# --- База и сервисы ---------------------------------------------------------
# Значение ниже — для запуска с хоста (CLI, alembic, `lab service ...`).
# В docker compose DATABASE_URL подставляется самим compose (host `db`) и это значение
# не используется; менять его для compose не нужно. Свой пароль — здесь и в POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5432/lab
# пароль пользователя lab для контейнера db (compose, по умолчанию lab)
POSTGRES_PASSWORD=
# потолок реального капитала первой фазы, USD (500–1000); пусто = из limits.yaml
REAL_CAPITAL_CAP=
# лимит на платные источники в месяц, USD (В3: 50)
BUDGET_MONTH_USD=
# каталог резервных копий базы (бэкап 03:00)
BACKUP_DIR=
# адрес:порт веб-экрана НА ХОСТЕ, например 127.0.0.1:8080 (8080 занят — ставь 127.0.0.1:8090)
WEB_BIND=
# логин HTTP Basic для веб-экрана
WEB_USER=
# пароль HTTP Basic для веб-экрана
WEB_PASSWORD=
# 1 — разрешить тесты с живыми API (по умолчанию пропускаются)
LAB_LIVE_TESTS=
# сети через запятую: solana,evm,ton (остальные — по флагу, G07)
CHAINS_ENABLED=

# --- Биржи (CEX) и DEX-перпы ------------------------------------------------
# ключ Bybit (только торговля, без вывода)
BYBIT_API_KEY=
# секрет Bybit
BYBIT_API_SECRET=
# ключ OKX
OKX_API_KEY=
# секрет OKX
OKX_API_SECRET=
# passphrase OKX
OKX_API_PASSPHRASE=
# ключ Binance
BINANCE_API_KEY=
# секрет Binance
BINANCE_API_SECRET=
# приватный ключ агент-кошелька Hyperliquid (не основной кошелёк)
HYPERLIQUID_PRIVATE_KEY=

# --- Robinhood и Polymarket -------------------------------------------------
# ключ Robinhood Crypto API
ROBINHOOD_API_KEY=
# приватный ключ подписи Robinhood
ROBINHOOD_PRIVATE_KEY=
# приватный ключ кошелька для Polymarket CLOB
POLYMARKET_PRIVATE_KEY=

# --- Горячие кошельки сетей (только тестовый капитал) -----------------------
# приватный ключ горячего кошелька Solana
SOLANA_HOT_WALLET_KEY=
# приватный ключ горячего кошелька Ethereum/Base/BNB
EVM_HOT_WALLET_KEY=
# мнемоника горячего кошелька TON
TON_HOT_WALLET_MNEMONIC=

# --- Источники данных -------------------------------------------------------
# Helius (Solana RPC и индексация)
HELIUS_API_KEY=
# Alchemy (EVM RPC)
ALCHEMY_API_KEY=
# Etherscan / Basescan / BscScan
ETHERSCAN_API_KEY=
# The Graph (сабграфы DEX)
THEGRAPH_API_KEY=
# Jupiter (свопы и котировки Solana)
JUPITER_API_KEY=
# Magic Eden (NFT)
MAGICEDEN_API_KEY=
# OpenSea (NFT)
OPENSEA_API_KEY=
# Tensor (NFT Solana) — при получении ключа
TENSOR_API_KEY=
# tonapi.io
TONAPI_KEY=
# Dune Analytics
DUNE_API_KEY=
# Cielo (смарт-мани фиды)
CIELO_API_KEY=
# источник свечей акций: alphavantage | yfinance
STOCK_DATA_PROVIDER=
# ключ Alpha Vantage (если STOCK_DATA_PROVIDER=alphavantage)
ALPHAVANTAGE_API_KEY=

# --- Telegram ----------------------------------------------------------------
# токен бота Trader
TELEGRAM_BOT_TOKEN=
# числовой id администратора; команды только от него
TELEGRAM_ADMIN_ID=
# необязательно: api_id Telethon; есть путь без ключей — веб-превью t.me/s
TELEGRAM_API_ID=
# необязательно: api_hash Telethon (нужен только вместе с api_id)
TELEGRAM_API_HASH=
