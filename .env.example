# Скопируй в .env и заполни. Значения нигде не логируются — только «заполнено / пусто».
# Ключи площадок создавай БЕЗ права вывода средств: ключ с withdraw отклоняется при старте.
# Хвостовые комментарии (` # ...`) в значения не попадают — файл можно копировать как есть:
# `cp .env.example .env` даёт рабочую конфигурацию без ключей (все площадки «только данные»).

# --- База и сервисы ---------------------------------------------------------
# Значение ниже — для запуска с хоста (CLI, alembic, `lab service ...`).
# В docker compose DATABASE_URL подставляется самим compose (host `db`) и это значение
# не используется; менять его для compose не нужно. Свой пароль — здесь и в POSTGRES_PASSWORD.
DATABASE_URL=postgresql+psycopg://lab:lab@localhost:5432/lab
POSTGRES_PASSWORD=       # пароль пользователя lab для контейнера db (compose, по умолчанию lab)
REAL_CAPITAL_CAP=        # потолок реального капитала первой фазы, USD (500–1000); пусто = из limits.yaml
BUDGET_MONTH_USD=        # лимит на платные источники в месяц, USD (В3: 50)
BACKUP_DIR=              # каталог резервных копий базы (бэкап 03:00)
WEB_BIND=                # адрес:порт веб-экрана НА ХОСТЕ, например 127.0.0.1:8080 (8080 занят — ставь 127.0.0.1:8090)
WEB_USER=                # логин HTTP Basic для веб-экрана
WEB_PASSWORD=            # пароль HTTP Basic для веб-экрана
LAB_LIVE_TESTS=          # 1 — разрешить тесты с живыми API (по умолчанию пропускаются)
CHAINS_ENABLED=          # сети через запятую: solana,evm,ton (остальные — по флагу, G07)

# --- Биржи (CEX) и DEX-перпы ------------------------------------------------
BYBIT_API_KEY=           # ключ Bybit (только торговля, без вывода)
BYBIT_API_SECRET=        # секрет Bybit
OKX_API_KEY=             # ключ OKX
OKX_API_SECRET=          # секрет OKX
OKX_API_PASSPHRASE=      # passphrase OKX
BINANCE_API_KEY=         # ключ Binance
BINANCE_API_SECRET=      # секрет Binance
HYPERLIQUID_PRIVATE_KEY= # приватный ключ агент-кошелька Hyperliquid (не основной кошелёк)

# --- Robinhood и Polymarket -------------------------------------------------
ROBINHOOD_API_KEY=       # ключ Robinhood Crypto API
ROBINHOOD_PRIVATE_KEY=   # приватный ключ подписи Robinhood
POLYMARKET_PRIVATE_KEY=  # приватный ключ кошелька для Polymarket CLOB

# --- Горячие кошельки сетей (только тестовый капитал) -----------------------
SOLANA_HOT_WALLET_KEY=   # приватный ключ горячего кошелька Solana
EVM_HOT_WALLET_KEY=      # приватный ключ горячего кошелька Ethereum/Base/BNB
TON_HOT_WALLET_MNEMONIC= # мнемоника горячего кошелька TON

# --- Источники данных -------------------------------------------------------
HELIUS_API_KEY=          # Helius (Solana RPC и индексация)
ALCHEMY_API_KEY=         # Alchemy (EVM RPC)
ETHERSCAN_API_KEY=       # Etherscan / Basescan / BscScan
THEGRAPH_API_KEY=        # The Graph (сабграфы DEX)
JUPITER_API_KEY=         # Jupiter (свопы и котировки Solana)
MAGICEDEN_API_KEY=       # Magic Eden (NFT)
OPENSEA_API_KEY=         # OpenSea (NFT)
TENSOR_API_KEY=          # Tensor (NFT Solana) — при получении ключа
TONAPI_KEY=              # tonapi.io
DUNE_API_KEY=            # Dune Analytics
CIELO_API_KEY=           # Cielo (смарт-мани фиды)
STOCK_DATA_PROVIDER=     # источник свечей акций: alphavantage | yfinance
ALPHAVANTAGE_API_KEY=    # ключ Alpha Vantage (если STOCK_DATA_PROVIDER=alphavantage)

# --- Telegram ----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=      # токен бота Trader
TELEGRAM_ADMIN_ID=       # числовой id администратора; команды только от него
TELEGRAM_API_ID=         # необязательно: api_id Telethon; есть путь без ключей — веб-превью t.me/s
TELEGRAM_API_HASH=       # необязательно: api_hash Telethon (нужен только вместе с api_id)
